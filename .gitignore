# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
*.egg-info

# Virtual environments
.venv
venv/
env/

# 工具缓存
.pytest_cache/
.mypy_cache/
.cache/

# 编辑器
.idea/

# 操作系统
.DS_Store
Thumbs.db

# 密钥 / 本地配置
.env
.env.*
!.env.example
*.key
*.pem
secrets.json

# 训练产物（模型权重、checkpoint 动辄几个 GB）
*.pt
*.pth
*.ckpt
*.safetensors
out/
checkpoints/
logs/
wandb/

# 数据集语料与本地训练出来的分词器（体积大 / 可重新生成）
dataset/*.jsonl
model/tokenizer.json
model/tokenizer_config.json
model/special_tokens_map.json

# 打包语料（trainer/pack_corpus.py 产出，1G 语料打包后约 1.5GB）
# 纯派生数据，可用同一条命令重新生成，不进仓库
dataset/packed/

# 教学材料（本仓库的课程/术语表/学习记录，只在本地学习用，不进仓库）
# 用前导 / 锚定在仓库根目录，避免误伤未来可能出现的 web/assets/ 之类同名字目录
/MISSION.md
/NOTES.md
/RESOURCES.md
/assets/
/lessons/
/reference/
/learning-records/

# 上游 MiniMind 源码快照（教学用事实基准：reference/*.html 会引用它）
# 是别人仓库的代码副本，不代表本项目，不进仓库
/minimind_sources/

# 诊断 / 验证用的临时脚本目录
/.tmpprobe/
